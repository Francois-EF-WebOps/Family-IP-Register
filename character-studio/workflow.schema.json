{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://francois-ef-webops.github.io/Family-IP-Register/character-studio/workflow.schema.json",
  "title": "Resumable Workflow State",
  "description": "Reusable, project-independent progress and missing-information record.",
  "type": "object",
  "required": ["workflow_version", "project_id", "current_stage", "stages", "updated_at"],
  "properties": {
    "workflow_version": { "const": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "current_stage": { "type": "string", "minLength": 1 },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stage_id", "label", "status", "missing"],
        "properties": {
          "stage_id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "status": { "enum": ["not_started", "in_progress", "blocked", "complete"] },
          "missing": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["field", "state"],
              "properties": {
                "field": { "type": "string", "minLength": 1 },
                "state": { "enum": ["unknown", "incomplete", "conflict", "verified"] },
                "note": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
