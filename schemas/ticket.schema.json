{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Francois-EF-WebOps/Family-IP-Register/blob/main/schemas/ticket.schema.json",
  "title": "Portfolio Ticket",
  "description": "Normalized, read-only export of a GitHub Issue. GitHub remains the source of truth.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ticket_id", "source_url", "repository", "number", "title", "type", "status", "priority", "state", "acceptance_criteria"],
  "properties": {
    "ticket_id": {"type": "string", "pattern": "^[^/]+/[^#]+#[1-9][0-9]*$"},
    "source_url": {"type": "string", "format": "uri"},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "number": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1},
    "type": {"enum": ["EPIC", "TASK", "BUG", "RESEARCH", "DECISION", "RELEASE", "BLOCKER", "UNCLASSIFIED"]},
    "status": {"enum": ["BACKLOG", "READY", "IN_PROGRESS", "BLOCKED", "REVIEW", "DONE", "UNCLASSIFIED"]},
    "priority": {"enum": ["P0", "P1", "P2", "P3", "UNSET"]},
    "state": {"enum": ["open", "closed"]},
    "state_reason": {"type": ["string", "null"], "enum": ["completed", "not_planned", "duplicate", "reopened", null]},
    "assignees": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "labels": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "milestone": {"type": ["string", "null"]},
    "parent_ticket": {"type": ["string", "null"]},
    "dependencies": {"type": "array", "items": {"type": "string", "format": "uri"}, "uniqueItems": true},
    "acceptance_criteria": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidence": {"type": "array", "items": {"type": "string", "format": "uri"}, "uniqueItems": true},
    "external_counterparty": {"type": ["string", "null"]},
    "target_date": {"type": ["string", "null"], "format": "date"},
    "created_at": {"type": ["string", "null"], "format": "date-time"},
    "updated_at": {"type": ["string", "null"], "format": "date-time"},
    "closed_at": {"type": ["string", "null"], "format": "date-time"},
    "last_reviewed_at": {"type": ["string", "null"], "format": "date-time"},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}